<!DOCTYPE html>
<html class="scrollable-area scrollbar-rounded scroll-smooth md:scroll-auto" lang="ms" translate="no">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body class="text-base-content select-none"
        data-controller="application theme service-worker geolocation turbo-navigation"
        data-action="turbo:before-visit@document->turbo-navigation#rememberLocation">
    <div class="absolute inset-0 h-96 pt-16 box-content -z-1 w-full md:pl-24 safe-top">
      <%= image_tag random_bg, class: "absolute inset-0 w-full h-screen bg-top bg-cover object-cover object-[85%_15%] opacity-90 max-w-full ", alt: "", loading: "lazy", decoding: "async" %>
      <div class="absolute inset-0 bg-linear-to-b from-base-100 to-transparent w-full h-60" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-linear-to-t from-base-100 to-transparent w-full h-screen" aria-hidden="true"></div>
    </div>
    <div class="md:pl-24">
      <%= render "layouts/header" %>
      <% if content_for?(:hero) %>
        <%= yield :hero %>
      <% end %>
      <section id="pages" class="flex flex-col">
        <%= yield %>
      </section>
      <% if content_for?(:modal) %>
        <input id="filter-modal" class="modal-toggle" type="checkbox">
        <div class="modal modal-bottom justify-center z-1000">
          <div class="modal-box  overflow-hidden h-svh w-screen max-w-screen md:max-w-[720px] p-0 rounded-t-3xl backdrop-blur-md bg-white/20 safe-top safe-bottom" data-controller="filter">
            <%= yield :modal %>
            <div class="modal-action"></div>
          </div>
        </div>
      <% end %>
    </div>
    <%= render "layouts/sidebar" %>
    <%= render "layouts/analytics" if Rails.env.production? %>
    <%= render "layouts/dock" %>
  </body>
</html>
