<% content_for :title, "Arah Kiblat" %>
<% content_for :description, "Cari arah kiblat menggunakan kompas digital" %>

<div class="container mx-auto px-4 py-8 md:py-12 max-w-lg">
  <div class="backdrop-blur-md bg-base-100/30 rounded-3xl p-8 border border-white/20 shadow-2xl"
       data-controller="qibla"
       data-qibla-zone-lat-value="<%= @location['latitude'] %>"
       data-qibla-zone-lng-value="<%= @location['longitude'] %>"
       data-qibla-zone-name-value="<%= @location['location'] %>">

    <!-- Header -->
    <h1 class="text-2xl font-bold text-center mb-2">Arah Kiblat</h1>
    <p class="text-center text-base-content/60 text-sm mb-6" data-qibla-target="status">Memulakan...</p>

    <!-- Compass Container (SVG) -->
    <div class="relative w-72 h-72 md:w-80 md:h-80 mx-auto mb-6" data-qibla-target="container">
      <!-- Outer ring for alignment highlight -->
      <div class="absolute inset-0 rounded-full transition-all duration-300 ease-out"
           data-qibla-target="ring"></div>

      <svg viewBox="0 0 400 400" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="compassShadow" x="-10%" y="-10%" width="120%" height="120%">
            <feDropShadow dx="0" dy="2" stdDeviation="6" flood-opacity="0.15"/>
          </filter>
          <linearGradient id="needleGrad" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="oklch(var(--p))" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="oklch(var(--p))"/>
          </linearGradient>
        </defs>

        <!-- Compass dial (rotates with device heading) -->
        <g data-qibla-target="compass">
          <!-- Outer circle -->
          <circle cx="200" cy="200" r="190" fill="oklch(var(--b100) / 0.2)" stroke="oklch(var(--bc) / 0.3)" stroke-width="3" filter="url(#compassShadow)"/>

          <!-- Inner circle -->
          <circle cx="200" cy="200" r="170" fill="none" stroke="oklch(var(--bc) / 0.15)" stroke-width="1"/>

          <!-- Minor tick marks (every 10°, skip cardinals/intercardinals) -->
          <% (0...360).step(10).reject { |d| d % 45 == 0 }.each do |deg| %>
            <line x1="200" y1="15" x2="200" y2="25"
                  stroke="oklch(var(--bc) / 0.35)" stroke-width="1.5"
                  transform="rotate(<%= deg %> 200 200)"/>
          <% end %>

          <!-- Intercardinal tick marks -->
          <% [45, 135, 225, 315].each do |deg| %>
            <line x1="200" y1="12" x2="200" y2="28"
                  stroke="oklch(var(--bc) / 0.5)" stroke-width="2.5"
                  transform="rotate(<%= deg %> 200 200)"/>
          <% end %>

          <!-- Cardinal tick marks (N/S/E/W) -->
          <% [0, 90, 180, 270].each do |deg| %>
            <line x1="200" y1="10" x2="200" y2="32"
                  stroke="oklch(var(--bc) / 0.8)" stroke-width="3"
                  transform="rotate(<%= deg %> 200 200)"/>
          <% end %>

          <!-- Cardinal labels -->
          <text x="200" y="54" text-anchor="middle" dominant-baseline="middle"
                fill="oklch(var(--p))" font-size="22" font-weight="bold">U</text>
          <text x="200" y="350" text-anchor="middle" dominant-baseline="middle"
                fill="oklch(var(--bc) / 0.6)" font-size="20">S</text>
          <text x="54" y="204" text-anchor="middle" dominant-baseline="middle"
                fill="oklch(var(--bc) / 0.6)" font-size="20">B</text>
          <text x="346" y="204" text-anchor="middle" dominant-baseline="middle"
                fill="oklch(var(--bc) / 0.6)" font-size="20">T</text>

          <!-- Intercardinal labels -->
          <text x="96" y="96" text-anchor="middle" dominant-baseline="middle"
                fill="oklch(var(--bc) / 0.45)" font-size="14">BL</text>
          <text x="304" y="96" text-anchor="middle" dominant-baseline="middle"
                fill="oklch(var(--bc) / 0.45)" font-size="14">TL</text>
          <text x="304" y="310" text-anchor="middle" dominant-baseline="middle"
                fill="oklch(var(--bc) / 0.45)" font-size="14">TD</text>
          <text x="96" y="310" text-anchor="middle" dominant-baseline="middle"
                fill="oklch(var(--bc) / 0.45)" font-size="14">BD</text>
        </g>

        <!-- Qibla needle (fixed, rotates to point at bearing) -->
        <g data-qibla-target="needle">
          <!-- Main needle (points UP toward qibla) -->
          <polygon points="200,55 194,170 206,170" fill="url(#needleGrad)" opacity="0.9"/>
          <!-- Tail needle (opposite direction) -->
          <polygon points="200,345 196,235 204,235" fill="oklch(var(--bc) / 0.25)"/>
          <!-- Kaaba icon at needle tip -->
          <g transform="translate(200, 45)">
            <rect x="-10" y="-10" width="20" height="20" rx="2" fill="oklch(var(--p))" stroke="oklch(var(--pc))" stroke-width="1"/>
            <line x1="-6" y1="0" x2="6" y2="0" stroke="oklch(var(--pc))" stroke-width="1.5"/>
            <rect x="-3" y="2" width="6" height="5" rx="1" fill="none" stroke="oklch(var(--pc))" stroke-width="1"/>
          </g>
        </g>

        <!-- Center cap -->
        <circle cx="200" cy="200" r="14" fill="oklch(var(--b100))" stroke="oklch(var(--p))" stroke-width="3"/>
        <circle cx="200" cy="200" r="5" fill="oklch(var(--p))"/>
      </svg>
    </div>

    <!-- Bearing Display -->
    <div class="text-center mb-6">
      <div class="text-5xl font-bold tabular-nums" data-qibla-target="bearing">--°</div>
      <div class="text-sm text-base-content/60 mt-1">darjah dari Utara</div>
    </div>

    <!-- Location Info -->
    <div class="backdrop-blur-sm bg-white/10 rounded-2xl p-4 border border-white/10">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
          <%= icon "map-pin", class: "size-5 text-primary" %>
        </div>
        <div class="flex-1">
          <div class="font-medium" data-qibla-target="location">Mengesan lokasi...</div>
          <div class="text-xs text-base-content/50" data-qibla-target="coordinates">-</div>
        </div>
      </div>
    </div>

    <!-- Permission Button (iOS) -->
    <button class="btn btn-primary btn-block mt-4 hidden"
            data-qibla-target="permissionBtn"
            data-action="click->qibla#requestPermission">
      <%= icon "compass", class: "size-5" %>
      Aktifkan Kompas
    </button>

    <!-- Warning Messages -->
    <div class="alert alert-warning mt-4 hidden" data-qibla-target="warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span></span>
    </div>

    <!-- Info -->
    <div class="mt-6 text-center text-xs text-base-content/50">
      <p>Halakan peranti anda mengikut arah jarum kompas untuk menghadap kiblat.</p>
      <p class="mt-1">Koordinat Kaabah: 21.4225°N, 39.8262°E</p>
    </div>
  </div>
</div>
